EXPO_PUBLIC_API_URL=https://api.aimarkets.vn/v1
EXPO_PUBLIC_APP_ENV=development
# Google sign-in — client ids come from GET /v1/auth/google/config first; these are fallbacks.
# iOS: same value as the API's GOOGLE_IOS_CLIENT_ID. Read at BUILD time too
# (app.config.js registers com.googleusercontent.apps.{prefix} in Info.plist).
# Android: native SDK uses the Web client id as serverClientId; the Android client is
# matched by package + SHA-1 on Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_WEB_URL=https://aimarkets.vn
# OpenClaw Control UI: https://{userId}.openclaw.aimarkets.vn (launched via POST /v1/openclaw/launch)
