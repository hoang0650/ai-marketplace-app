EXPO_PUBLIC_API_URL=https://api.aimarkets.vn/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Legacy HTTPS bridge only (optional). App default uses API /auth/google/start?mobile=1
# which reuses Authorized redirect URI https://api.aimarkets.vn/v1/auth/google/callback
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://www.aimarkets.vn/assets/oauth/google-mobile.html
EXPO_PUBLIC_WEB_URL=https://aimarkets.vn
# OpenClaw Control UI: https://{userId}.openclaw.aimarkets.vn (launched via POST /v1/openclaw/launch)

