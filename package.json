{
  "name": "ai-marketplace-app",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start": "npx.cmd expo start",
    "start:dev-client": "npx.cmd expo start --dev-client",
    "start:tunnel": "npx.cmd expo start --tunnel",
    "start:lan": "npx.cmd expo start --lan --clear",
    "start-web": "npx.cmd expo start --web --clear",
    "build:dev:android": "npx.cmd --yes eas-cli@latest build --platform android --profile development",
    "build:dev:ios": "npx.cmd --yes eas-cli@latest build --platform ios --profile development",
    "build:android": "npx.cmd --yes eas-cli@latest build --platform android --profile production",
    "build:android:preview": "npx.cmd --yes eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx.cmd --yes eas-cli@latest build --platform ios --profile production",
    "submit:android": "npx.cmd --yes eas-cli@latest submit --platform android --profile production --latest",
    "submit:ios": "npx.cmd --yes eas-cli@latest submit --platform ios --profile production",
    "lint": "npx.cmd expo lint",
    "test": "npx.cmd jest --passWithNoTests",
    "typecheck": "npx.cmd tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.83.0",
    "expo": "^58.0.0",
    "expo-audio": "~58.0.3",
    "expo-auth-session": "~58.0.6",
    "expo-camera": "~58.0.5",
    "expo-clipboard": "~58.0.2",
    "expo-constants": "~58.0.9",
    "expo-crypto": "~58.0.3",
    "expo-dev-client": "~58.0.9",
    "expo-document-picker": "~58.0.3",
    "expo-font": "~58.0.4",
    "expo-iap": "^5.6.0",
    "expo-image": "~58.0.8",
    "expo-image-picker": "~58.0.9",
    "expo-keep-awake": "~58.0.2",
    "expo-linear-gradient": "~58.0.2",
    "expo-linking": "~58.0.9",
    "expo-local-authentication": "~58.0.1",
    "expo-network": "~58.0.2",
    "expo-notifications": "~58.0.9",
    "expo-router": "~58.0.10",
    "expo-screen-capture": "~58.0.4",
    "expo-screen-orientation": "~58.0.1",
    "expo-secure-store": "~58.0.1",
    "expo-speech": "~58.0.2",
    "expo-splash-screen": "~58.0.2",
    "expo-status-bar": "~58.0.2",
    "expo-system-ui": "~58.0.4",
    "expo-video": "~58.0.5",
    "expo-web-browser": "~58.0.3",
    "lucide-react-native": "^0.475.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
